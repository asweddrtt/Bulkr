<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- image_picker: shown when the user attaches a photo to a meal. iOS
	     rejects the app at review time without these, and crashes the picker at
	     runtime with no message the user can act on. -->
	<key>NSCameraUsageDescription</key>
	<string>Bulkr uses the camera so you can photograph a meal you are adding.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Bulkr needs your photo library so you can pick an existing photo for a meal.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Bulkr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>bulkr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Supabase OAuth callback. Must match SupabaseConfig.oauthRedirectUrl
	     and the Redirect URL allow-list in the Supabase dashboard. Without it
	     the provider finishes in Safari and never returns to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.alimahmoud.bulkr.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.alimahmoud.bulkr</string>
			</array>
		</dict>
		<!-- Native Google Sign-In.
		     The Google SDK finishes its flow by redirecting to the *reversed*
		     iOS client id, so this scheme has to exist or the account picker
		     opens, the user picks, and nothing comes back.

		     REPLACE the string below with the REVERSED_CLIENT_ID value out of
		     ios/Runner/GoogleService-Info.plist. It looks like
		     com.googleusercontent.apps.123456789012-abcdefg. It is not a
		     secret — it ships inside every copy of the app. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.alimahmoud.bulkr.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REPLACE_WITH_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
