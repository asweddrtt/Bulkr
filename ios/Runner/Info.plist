<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- image_picker: shown when the user attaches a photo to a meal. iOS
	     rejects the app at review time without these, and crashes the picker at
	     runtime with no message the user can act on. -->
	<!-- AdMob. The SDK reads this at startup and CRASHES THE APP ON LAUNCH if
	     it is missing or belongs to the other platform — it is not a soft
	     failure, and the symptom (a white screen, before Dart runs) is exactly
	     the one that shipped build 4.

	     This is the iOS app ID. The Android one lives in
	     android/app/src/main/AndroidManifest.xml and the two are NOT
	     interchangeable. See docs/ADMOB.md. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-6396760454728825~3261840114</string>
	<!-- App Tracking Transparency. Personalised ads need the IDFA, the IDFA
	     needs this prompt, and shipping ads without asking is a rejection
	     under guideline 5.1.2.

	     Worded as what the user gets rather than what we take: the prompt is
	     shown once per install and iOS will never show it again, so the
	     sentence is the only chance there is. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Bulkr uses this to keep the ads you see relevant, and to keep the app free. You can say no and still use everything.</string>
	<!-- SKAdNetwork: how an install is attributed without the IDFA, so this is
	     what earns money when someone declines the prompt above.

	     Only Google's own identifier is listed. If mediation is ever turned on
	     in the AdMob console, every mediated network needs its identifier here
	     too — Google publishes the current list at
	     https://developers.google.com/admob/ios/privacy/strategies, and a
	     missing entry is revenue that is silently not attributed rather than
	     an error anybody sees. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Bulkr uses the camera so you can photograph a meal you are adding.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Bulkr needs your photo library so you can pick an existing photo for a meal.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Bulkr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>bulkr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- The UIScene lifecycle, which iOS now expects and Flutter migrates to.
	     Written here rather than left to the build to insert, so the project
	     that gets archived is the project in the repository. Matches what
	     flutter_tools inserts, key for key. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Supabase OAuth callback. Must match SupabaseConfig.oauthRedirectUrl
	     and the Redirect URL allow-list in the Supabase dashboard. Without it
	     the provider finishes in Safari and never returns to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.alimahmoud.bulkr.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.alimahmoud.bulkr</string>
			</array>
		</dict>
		<!-- Native Google Sign-In.
		     The Google SDK finishes its flow by redirecting to the *reversed*
		     iOS client id, so this scheme has to exist or the account picker
		     opens, the user picks, and nothing comes back.

		     Reversed is the whole point. The OAuth client id reads
		     482455223938-xxx.apps.googleusercontent.com; a URL scheme is
		     written host-first, so it becomes
		     com.googleusercontent.apps.482455223938-xxx. Pasting the id as it
		     comes gives a scheme iOS will never match, and that failure looks
		     exactly like the scheme being absent.

		     The same id un-reversed is what goes in the GOOGLE_IOS_CLIENT_ID
		     build define; see lib/core/config/supabase_config.dart. It is not
		     from GoogleService-Info.plist and never will be: Google sign-in
		     belongs to the Cloud project behind Supabase Auth, and Firebase
		     here only sends pushes.

		     It is not a secret — it ships inside every copy of the app. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.alimahmoud.bulkr.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.482455223938-d4m26ijhdn9uoued3dvlu7hd9r10fhc5</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
