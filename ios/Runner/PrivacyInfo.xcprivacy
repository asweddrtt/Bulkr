<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bulkr's privacy manifest.

  Required by Apple since spring 2024. Two separate things live in here and
  they are judged differently:

    NSPrivacyAccessedAPITypes    "required reason" APIs. Using one without
                                 declaring a reason gets an ITMS-91053 email
                                 and, since May 2024, blocks the upload.
    NSPrivacyCollectedDataTypes  what leaves the device. This feeds the
                                 privacy report Xcode generates and has to
                                 agree with the nutrition labels entered in
                                 App Store Connect — they are entered
                                 separately and nothing checks they match.

  Third-party SDKs declare their own; this file covers the Runner target only.
  Kept in step with what the app actually does, which as of this release
  includes analytics and crash reporting that it did not have before.
-->
<plist version="1.0">
<dict>
	<!--
	  True, as of the release that added AdMob.

	  "Tracking" in Apple's sense is linking this data to third-party data for
	  advertising or data-broker purposes. That is exactly what a personalised
	  ad is, and Bulkr asks for permission to do it — see
	  NSUserTrackingUsageDescription in Info.plist.

	  It stays true even for users who decline the prompt, and even for
	  subscribers who see no ads at all. This declares what the *binary* is
	  capable of, not what happens to any one person: the SDK is in the app,
	  and a manifest that said otherwise because most users opt out would be
	  false in the way Apple checks for.
	-->
	<key>NSPrivacyTracking</key>
	<true/>

	<!--
	  Every domain the tracking above reaches. Apple's privacy report lists
	  connections to these, and a domain that is contacted but not declared is
	  the discrepancy that gets noticed.

	  These are Google's published AdMob endpoints. If mediation is ever turned
	  on in the AdMob console, each mediated network adds its own and they have
	  to be added here too:
	  https://developers.google.com/admob/ios/privacy/strategies
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>googleads.g.doubleclick.net</string>
		<string>pagead2.googlesyndication.com</string>
		<string>googleadservices.com</string>
		<string>google-analytics.com</string>
		<string>doubleclick.net</string>
		<string>googletagservices.com</string>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Supabase Auth, via Sign in with Apple or Google. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Display name and handle on the public profile. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The point of the app: weight, height, date of birth, calories and
		  macros. Health data is the most sensitive category here and is
		  deliberately listed rather than filed under "other user content".
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Meal and post photos, picked from the camera or library. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Direct messages between users. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Posts, comments, meal titles and descriptions. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Firebase Analytics. Linked to the account, because
		  `Telemetry.identify` sets the Supabase user id — which is what makes
		  a report actionable. No parameter carries user content; see the rule
		  at the top of lib/core/analytics_events.dart.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Crashlytics. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Performance timings that ride along with crash reports. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Two identifiers under one data type, which is how Apple files them.

		  The FCM registration token in `device_tokens` — an identifier for
		  this install, used to deliver a notification and nothing else — and,
		  since AdMob, the IDFA, which is read only when the user allows it at
		  the tracking prompt.

		  Tracking is true here because of the second one. It cannot be split:
		  the data type is declared once, and if any use of it is for
		  advertising then the declaration has to say so.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>

		<!--
		  What AdMob is told in order to choose an ad: coarse location derived
		  from the IP address, the device model, and the ad interactions
		  themselves. None of it is asked for by Bulkr — it is what the SDK
		  sends — which does not make it any less collected.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>

		<!--
		  Ad impressions and taps, reported by the SDK to Google. Distinct from
		  the Product Interaction entry above, which is Firebase Analytics and
		  carries no advertising identifier.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAdvertisingData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults. `AppPreferences` wraps shared_preferences to remember
		  where launch should go; easy_localization and supabase_flutter use it
		  too. CA92.1 is the reason code for an app reading and writing its own
		  defaults, which is all any of that does.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

		<!--
		  File timestamps. Reached through image_picker when a meal photo is
		  read, and through the caches cached_network_image keeps. C617.1 is
		  "files created by the app", which covers both.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>

		<!--
		  Free disk space, checked before writing a cached image. E174.1 is the
		  declared reason for writing to disk on the user's behalf.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>

		<!--
		  System boot time, used to measure elapsed time — the launch stopwatch
		  in `main`, and the timeouts in FoodRepository. 35F9.1 is the reason
		  for timing inside the app rather than identifying the device.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
